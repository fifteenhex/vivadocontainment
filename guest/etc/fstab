# / is a squashfs + tmpfs overlay assembled in the initramfs, not listed here.
# Projects live on the scratch disk, mounted by vc-scratch.
# By id rather than /dev/vdb: the letters depend on how many images are
# attached, and this one must not end up pointing at the scratch disk.
/dev/disk/by-id/virtio-vcvivado	@VIVADO_MNT@	erofs	ro,nofail	0 0
tmpfs		/tmp		tmpfs		rw,nosuid,nodev,size=50%	0 0
